{
  "name": "xeroxchat",
  "version": "2.0.0",
  "description": "Real-time chat application built with TypeScript, Express, Socket.IO, MySQL, JWT Authentication, and AI ChatBot",
  "main": "dist/server.js",

  "scripts": {

    "build": "tsc",

    "start": "node dist/server.js",

    "dev": "tsx watch src/server.ts",

    "lint": "eslint src/**/*.ts --fix",

    "lint:check": "eslint src/**/*.ts",

    "typecheck": "tsc --noEmit",

    "test": "vitest run",

    "test:watch": "vitest",

    "test:coverage": "vitest run --coverage",

    "test:ui": "vitest --ui"

  },

  "keywords": [

    "chat",

    "real-time",

    "socket.io",

    "typescript",

    "express",

    "mysql",

    "jwt",

    "authentication",

    "websocket",

    "chatbot",

    "fullstack"

  ],

  "author": "Yash Vidhate",

  "license": "MIT",

  "engines": {

    "node": ">=18.0.0"

  },

  "dependencies": {

    "bcryptjs": "^3.0.3",

    "dotenv": "^17.4.2",

    "express": "^5.2.1",

    "jsonwebtoken": "^9.0.3",

    "moment-timezone": "^0.6.0",

    "mysql2": "^3.22.3",

    "socket.io": "^4.8.3",

    "zod": "^4.3.5"

  },

  "devDependencies": {

    "@types/bcryptjs": "^2.4.6",

    "@types/express": "^5.0.6",

    "@types/jsonwebtoken": "^9.0.10",

    "@types/moment-timezone": "^0.5.13",

    "@types/node": "^25.7.0",

    "@vitest/coverage-v8": "^2.1.9",

    "@vitest/ui": "^2.1.9",

    "nodemon": "^3.1.14",

    "ts-node": "^10.9.2",

    "tsx": "^4.22.1",

    "typescript": "^5.9.3",

    "vitest": "^2.1.9"

  }

}